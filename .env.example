# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Bitcoin Core JSON-RPC
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=change_me
BITCOIN_RPC_PASSWORD=change_me

# PostgreSQL the indexer writes to
DATABASE_URL=postgresql://user:password@localhost:5432/amiable_indexer

# Bitcoin Core ZMQ publishers (zmqpubrawblock / zmqpubrawtx).
# In Polar, use the host ports shown in the bitcoind node's Connect tab.
ZMQ_BLOCK_URL=tcp://127.0.0.1:28332
# Optional: live mempool updates. Without it the mempool refreshes on new blocks only.
ZMQ_TX_URL=tcp://127.0.0.1:28333

# Tests only: a throwaway database (see README "Running tests").
# Must never point at DATABASE_URL.
# TEST_DATABASE_URL=postgres://amiable:amiable@127.0.0.1:55432/amiable_test
